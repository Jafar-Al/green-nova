# GREEN NOVA AI backend environment (placeholders only; never commit real values; there are no secrets in this service).
# The backend listens on 127.0.0.1:8000 ONLY (start command in backend/README.md). Browsers never reach it: the Next.js BFF does.

# Root of raw data and caches (kept outside the repo). Default: <home>/GreenNovaData
GREEN_NOVA_DATA=<path to data root>
# Where the job database, job results and logs live. Default: <GREEN_NOVA_DATA>/runtime
GREEN_NOVA_RUNTIME=<path to runtime dir>
# Application root containing backend/, models/ and regions/. Default: the folder two levels above backend/app.
# GREEN_NOVA_APP_ROOT=<path to app root>

# Limits (defaults shown)
GN_MAX_BODY_BYTES=262144
GN_MAX_POLYGON_IDS=500
GN_RATE_PER_MINUTE=240
GN_JOB_RATE_PER_HOUR=30
GN_MAX_ACTIVE_JOBS_PER_IP=2
GN_MAX_QUEUE=6
GN_JOB_TIMEOUT_S=1800
# Memory guard: a job starts only when this much physical RAM is free (MB); it waits GN_MEMORY_WAIT_S then fails.
GN_MIN_FREE_MB=2500
GN_MEMORY_WAIT_S=120
