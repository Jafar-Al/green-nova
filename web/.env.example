# GREEN NOVA AI web - environment variables (copy to .env.local; never commit real values; no secrets are needed).
#
# The frontend listens on 0.0.0.0:3000 (see package.json scripts). FastAPI is internal (127.0.0.1:8000 by default) and only ever
# called server-side by the Next.js BFF; browsers never talk to it directly. Put your own reverse proxy / platform in front for TLS.

# --- Site ---------------------------------------------------------------------------------
# Canonical origin for <link rel=canonical>, sitemap, robots and Open Graph tags. Set to your public URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: extra host names allowed to use the dev server (comma separated), e.g. a LAN name.
# ALLOWED_DEV_ORIGINS=

# --- Data provider ------------------------------------------------------------------------
# "api"  = real analysis through same-origin BFF route handlers /api/gn/* (default, inlined at build time).
# "demo" = clearly labelled synthetic data generated locally, for UI development only (shows the DEMONSTRATION DATA bar everywhere).
NEXT_PUBLIC_DATA_PROVIDER=api
# SERVER-ONLY: where the Next.js BFF reaches FastAPI. Must be a loopback/private address. Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000

# --- Interactive map basemap --------------------------------------------------------------
# XYZ raster tile template. A path starting with "/" is resolved against the page origin at runtime
# (works on localhost:3000 and behind any proxy). Default = self-hosted Sentinel-2 L2A pyramid of all Jordan rendered by
# web/scripts/imagery (Copernicus open data, free and open licence, see docs/ASSETS.md).
NEXT_PUBLIC_SATELLITE_TILE_URL=/tiles/s2/{z}/{x}/{y}.jpg
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=Contains modified Copernicus Sentinel data
NEXT_PUBLIC_SATELLITE_MIN_ZOOM=5
NEXT_PUBLIC_SATELLITE_MAX_ZOOM=11
# Optional west,south,east,north bounds in which tiles exist (limits 404 requests). Default: all of Jordan.
NEXT_PUBLIC_SATELLITE_BOUNDS=
# Licence caveat: do NOT point this at EOX Sentinel-2 cloudless (CC BY-NC-SA, non-commercial),
# Esri World Imagery or Mapbox Satellite unless you hold the commercial terms/keys for your site. See docs/ASSETS.md.
