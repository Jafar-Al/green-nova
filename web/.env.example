# GREEN NOVA AI web - environment variables (copy to .env.local; never commit real values)
#
# FIXED topology (owner instruction): the frontend ALWAYS listens on 0.0.0.0:3000 (see package.json scripts),
# reached publicly as https://greennova.dosteam.org through the owner's Cloudflare Tunnel (HTTPS ends at Cloudflare).
# FastAPI (Phase C) is internal only at 127.0.0.1:8000; browsers never talk to it directly.

# --- Site / domain ------------------------------------------------------------------------
GREEN_NOVA_DOMAIN=greennova.dosteam.org
# Canonical origin for <link rel=canonical>, sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://greennova.dosteam.org

# --- Data provider ------------------------------------------------------------------------
# "api"  = real analysis through same-origin BFF route handlers /api/gn/* (production default, inlined at build time).
# "demo" = clearly labelled synthetic data generated locally (shows the DEMONSTRATION DATA bar everywhere).
NEXT_PUBLIC_DATA_PROVIDER=api
# SERVER-ONLY (Phase C): where the Next.js BFF reaches FastAPI. Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000

# --- Interactive map basemap --------------------------------------------------------------
# XYZ raster tile template. A path starting with "/" is resolved against the page origin at runtime
# (so it works on localhost:3000 and behind the tunnel). Default = self-hosted Sentinel-2 L2A pyramid rendered by
# web/scripts/imagery (Copernicus open data, free and open licence, see docs/ASSETS.md).
NEXT_PUBLIC_SATELLITE_TILE_URL=/tiles/s2/{z}/{x}/{y}.jpg
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=Contains modified Copernicus Sentinel data
NEXT_PUBLIC_SATELLITE_MIN_ZOOM=5
NEXT_PUBLIC_SATELLITE_MAX_ZOOM=11
# Optional west,south,east,north bounds in which tiles exist (limits 404 requests).
NEXT_PUBLIC_SATELLITE_BOUNDS=
# Production licence caveat: do NOT point this at EOX Sentinel-2 cloudless (CC BY-NC-SA, non-commercial),
# Esri World Imagery or Mapbox Satellite unless the commercial terms/keys for this site have been
# obtained by the owner. See docs/ASSETS.md.
