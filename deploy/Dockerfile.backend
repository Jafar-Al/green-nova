# Backend image (FastAPI + both models, CPU only). Build from the repository root: docker build -f deploy/Dockerfile.backend .
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend backend
COPY models models
COPY regions regions
ENV GREEN_NOVA_APP_ROOT=/app GREEN_NOVA_DATA=/data PYTHONUNBUFFERED=1 CUDA_VISIBLE_DEVICES=
VOLUME /data
# Loopback only: the web container shares this network namespace (see docker-compose.yml); the port is never published.
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "127.0.0.1", "--port", "8000", "--workers", "1", "--no-server-header"]
