# Web image (Next.js standalone). Build from the repository root: docker build -f deploy/Dockerfile.web --build-arg NEXT_PUBLIC_SITE_URL=https://your.public.url .
FROM node:22-slim AS build
WORKDIR /w
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_DATA_PROVIDER=api GN_STANDALONE=1 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim
WORKDIR /srv
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 BACKEND_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
COPY --from=build /w/.next/standalone ./
COPY --from=build /w/.next/static ./.next/static
COPY --from=build /w/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
