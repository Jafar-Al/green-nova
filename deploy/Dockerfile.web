# syntax=docker/dockerfile:1
# Web image (Next.js standalone server). Build with the web/ folder as the context:
#   docker build -f deploy/Dockerfile.web --build-arg NEXT_PUBLIC_SITE_URL=https://your.public.url web
FROM node:22-slim AS deps
WORKDIR /w
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-slim AS build
WORKDIR /w
COPY --from=deps /w/node_modules node_modules
COPY . .
# NEXT_PUBLIC_* values are inlined at build time: set the public URL when you build.
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_DATA_PROVIDER=api GN_STANDALONE=1 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 BACKEND_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
WORKDIR /srv
COPY --from=build --chown=node:node /w/.next/standalone ./
COPY --from=build --chown=node:node /w/.next/static ./.next/static
COPY --from=build --chown=node:node /w/public ./public
USER node
EXPOSE 3000
# Goes through the server-side proxy to the backend, so "healthy" means the web server AND the backend behind it answer.
HEALTHCHECK --interval=15s --timeout=8s --start-period=20s --retries=4 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/gn/regions').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "server.js"]
