* text=auto
*.ps1 text eol=crlf
*.tif binary
*.npy binary
*.npz binary
*.pkl binary
*.jpg binary
*.png binary
*.webp binary
# Hash-verified artifacts must keep their EXACT bytes (no line-ending conversion on checkout), otherwise the
# sha256 checks in the model examples fail on Windows.
models/*/checkpoints/** -text
models/*/runtime_data/** -text
models/*/sample_data/** -text

# container build inputs keep LF line endings on every platform
.dockerignore text eol=lf
**/.dockerignore text eol=lf
deploy/Dockerfile.* text eol=lf
docker-compose.yml text eol=lf
requirements*.txt text eol=lf
