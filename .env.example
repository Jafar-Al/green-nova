# GREEN NOVA AI - environment template. Copy to the real places named below. NEVER commit real values.
# Placeholders only; no secrets are needed to run the application or the models locally.

# ---- Backend (FastAPI, internal 127.0.0.1:8000). Set in the shell that starts the backend (scripts\run_backend.ps1 does this).
# Folder for the job database, job results and logs. Default if unset: %USERPROFILE%\GreenNovaData\runtime
GREEN_NOVA_DATA=C:\GreenNovaData
GREEN_NOVA_RUNTIME=C:\GreenNovaData\runtime
# Repo root that contains backend\, models\, regions\ (default: the folder two levels above backend\app)
# GREEN_NOVA_APP_ROOT=
# Model 1 sub-area inference needs the large runtime bundle (NOT in the repo, see HANDOFF_REPORT.md). Optional.
# GREEN_NOVA_RUNTIME for Model 1 may point at models\suitability\sample_data for the portable example.

# ---- Frontend (Next.js, 0.0.0.0:3000): put in web\.env.local (see web\.env.example for all variables)
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DATA_PROVIDER=api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GREEN_NOVA_DOMAIN=localhost

# ---- Operations only (this-PC deployment + Cloudflare helper). Do not store in the repo or in chat.
# CLOUDFLARE_API_TOKEN=<set as a Windows USER environment variable, scopes: Zone:DNS:Edit, Zone:Zone:Read, Account:Cloudflare Tunnel:Edit>
