# GREEN NOVA AI - environment template. Copy to the real places named below. NEVER commit real values.
# Placeholders only; no secrets are needed to run the application or the models.

# ---- Backend (FastAPI, internal 127.0.0.1:8000). Set in the shell that starts the backend (scripts\run_backend.ps1 does this).
# Folder for the job database, job results and logs. Default if unset: %USERPROFILE%\GreenNovaData\runtime
GREEN_NOVA_DATA=<path to data root>
GREEN_NOVA_RUNTIME=<path to runtime dir>
# Repo root that contains backend\, models\, regions\ (default: the folder two levels above backend\app)
# GREEN_NOVA_APP_ROOT=
# Optional: Model 1 sub-area inference reads its runtime windows from here (see docs/MODEL1_SUITABILITY.md); the portable
# example points it at models\suitability\sample_data. Not needed to serve the committed governorate results.
# GREEN_NOVA_M1_RUNTIME=<path to runtime\model1>

# ---- Frontend (Next.js, 0.0.0.0:3000): put in web\.env.local (see web\.env.example for all variables)
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DATA_PROVIDER=api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Docker Compose (optional; all have defaults). Copy this file to .env next to docker-compose.yml
# Host port of the web server
# GREEN_NOVA_PORT=3000
# Public URL of the site. Inlined at build time: rebuild the web image after changing it
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend limits: minimum free RAM (MB) before a job starts, jobs per client per hour, queue length, container memory limit
# GN_MIN_FREE_MB=1500
# GN_JOB_RATE_PER_HOUR=30
# GN_MAX_QUEUE=6
# GN_BACKEND_MEM_LIMIT=6g
